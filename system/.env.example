# Caught — local dev config. Copy to .env (git-ignored) and adjust as needed.
# Secrets and config come from the environment only (code-standards.md Section 6);
# no hostnames, URLs, or paths are hard-coded in the services.

# The Redis pub/sub spine (flows / verdicts channels).
REDIS_URL=redis://redis:6379

# Where the backend reaches the ml-service (control API, from the keystone K1).
ML_SERVICE_URL=http://ml-service:8000

# Where the browser reaches the backend (frontend talks only to the backend).
# Keep the port in sync with BACKEND_PORT below.
VITE_BACKEND_URL=http://localhost:3001

# --- Host ports (left of the colon in compose). Override if one is taken.
#     The internal container ports never change; only what the host publishes. ---
ML_SERVICE_PORT=8000
BACKEND_PORT=3001
FRONTEND_PORT=5173

# --- ml-service, consumed from the keystone (K1) onward, listed here now
#     because the spec names them as Layer 0 configuration ---
# The v1 joblib models (git-ignored, local); needed once inference lands.
MODELS_DIR=../models
# The frozen featurizer parity artifact (built in the featurizer block, this Layer).
FEATURIZER_META=./ml-service/featurizer/featurizer_meta.json
